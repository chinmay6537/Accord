# Optional. Without a key the app uses built-in rules instead of Claude.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# 1 = show the OTP on screen (hackathon demo). Set 0 and plug in an SMS provider for real use.
DEMO_MODE=1
DB_PATH=data/accord.db
# Voice notes: set to turn on Whisper transcription. Without it, you type what the voice note says.
OPENAI_API_KEY=
# Uploaded evidence files are stored here (git-ignored via data/)
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=25
# Deployment helpers (see DEPLOY.md)
# Create the demo dealer + customer on every start:
SEED_DEMO=0

# --- Which reader extracts terms: auto (Claude if key, then local, then rules) | claude | local | rules
LLM_PROVIDER=auto
# --- Local model on another laptop (see LOCAL_LLM.md)
LOCAL_LLM_URL=
LOCAL_LLM_TOKEN=
LOCAL_LLM_TIMEOUT=120
LOCAL_LLM_KIND=gateway
